<div class="notification-banner no-print">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="notice">
                    <strong class="title">@Environment.GetEnvironmentVariable("BANNER_TITLE")</strong>
                    <p>@(Html.Raw(Environment.GetEnvironmentVariable("BANNER_MESSAGE")))</p>
                </div>
            </div>
        </div>
    </div>
</div>
